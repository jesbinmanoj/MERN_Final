# Backend Server Port
PORT=5000

# MongoDB Connection String (Atlas free-tier test cluster or local)
# Replace with your own MongoDB Atlas URI if desired:
# Format: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/recipe_book?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://examuser:ExamPassword123@cluster0.abcde.mongodb.net/recipe_book?retryWrites=true&w=majority

# Application Environment
NODE_ENV=development
